        <mxCell id="legend_text1" value="Synchronous call (request đồng bộ)" style="text;html=1;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="135" y="818" width="220" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend_arrow2" style="endArrow=open;html=1;rounded=0;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="828" as="sourcePoint" />
            <mxPoint x="430" y="828" as="targetPoint" />
          </mxGeometry>
