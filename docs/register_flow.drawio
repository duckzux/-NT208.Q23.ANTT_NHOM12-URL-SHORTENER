        <mxCell id="legend_text2" value="Return value (giá trị trả về)" style="text;html=1;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="818" width="180" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend_note" value="❗ Note (rẽ nhánh / ngoại lệ)" style="text;html=1;align=left;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="650" y="818" width="200" height="20" as="geometry" />
