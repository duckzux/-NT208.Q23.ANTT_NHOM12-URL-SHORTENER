# ── VPS Deployment ────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values before running docker compose.

# Database password for MySQL root user
DB_PASSWORD=change_this_strong_password

# App URL — use your VPS IP or domain, no trailing slash
APP_URL=http://your-vps-ip

# Session secret — generate with: openssl rand -hex 32
SESSION_SECRET=change_this_to_a_long_random_string

# Set to "true" only when running behind HTTPS (SSL certificate configured)
COOKIE_SECURE=false

# Node environment (keep "production" for VPS)
NODE_ENV=production
